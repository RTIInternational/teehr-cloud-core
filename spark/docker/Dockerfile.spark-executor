# Use the official Apache Spark image as the base image (Java 17 to match JupyterHub driver)
FROM apache/spark:4.0.1-scala2.13-java17-ubuntu

USER 0

ARG TEEHR_VERSION

# Use HTTPS apt mirrors so builds work when plain HTTP egress is blocked.
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' /etc/apt/sources.list

# Add deadsnakes PPA and install Python 3.12. Only runtime packages: no
# compilers or -dev headers, which made up most of the image's OS CVEs.
# software-properties-common is purged before any pip install: it pulls in
# system Python packages (e.g. python3-six) that pip would otherwise treat as
# already installed and then lose when they are auto-removed.
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    git \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y \
    python3.12 \
    python3.12-venv \
    && apt-get purge -y --auto-remove software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Install pip for Python 3.12 using ensurepip
RUN python3.12 -m ensurepip --upgrade

# Install TEEHR. On x86_64 everything installs from wheels. exactextract has no
# aarch64 wheel (local KinD on Apple Silicon), so there it is compiled: the
# toolchain and -dev headers are installed and purged in this same layer, keeping
# gdal-bin so the GDAL/GEOS runtime libraries exactextract links against remain.
RUN if [ "$(uname -m)" = "aarch64" ]; then \
        BUILD_DEPS="build-essential python3.12-dev libgdal-dev libgeos-dev"; \
        apt-get update && apt-get install -y gdal-bin $BUILD_DEPS; \
    fi \
    && GIT_LFS_SKIP_SMUDGE=1 python3.12 -m pip install --no-cache-dir \
        "git+https://github.com/RTIInternational/teehr.git@${TEEHR_VERSION}" \
    && if [ -n "${BUILD_DEPS:-}" ]; then \
        apt-get purge -y --auto-remove $BUILD_DEPS && rm -rf /var/lib/apt/lists/*; \
    fi

# Executors run Spark from SPARK_HOME (/opt/spark), so the second copy of the
# jars that the pyspark wheel brings in is unused, as are Spark's examples.
COPY patch-spark-jars.sh /tmp/patch-spark-jars.sh
RUN rm -rf "$(python3.12 -c 'import os, pyspark; print(os.path.join(pyspark.__path__[0], "jars"))')" \
        /opt/spark/examples \
    && sh /tmp/patch-spark-jars.sh /opt/spark/jars \
    && rm /tmp/patch-spark-jars.sh

# git was only needed for the pip install above.
RUN apt-get purge -y --auto-remove git \
    && rm -rf /var/lib/apt/lists/*

# Point python3 (what Spark launches Python workers with) at 3.12. Done after
# all apt steps, since installing Ubuntu's python3 package replaces this link.
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3

# Fail the build if the purges above removed anything teehr needs at runtime.
RUN python3 -c "import teehr, exactextract, rasterio, pyspark"

# change spark UID and GID to 1000
RUN usermod -u 1000 spark && groupmod -g 1000 spark

# Ensure work directory is owned by spark user
RUN chown -R spark:spark /opt/spark/work-dir

# Switch back to spark user
USER 1000
