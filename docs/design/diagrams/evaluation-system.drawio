<mxfile host="Electron" type="device"><diagram id="page-0" name="Evaluation system in deployments"><mxGraphModel dx="1500" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="770" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="grp-shared" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="340" height="490" as="geometry"/></mxCell><mxCell id="grp-shared-label" value="Built once" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="100" height="30" as="geometry"/></mxCell><mxCell id="eval" value='&lt;b&gt;teehr-evaluation-system&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;API / SDK and write gateway, evaluation spec, control plane (projects, members, datasets, runs), metric engine, evaluation Prefect flows (upload validation, on-demand analytics), canonical warehouse schema&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="45" y="80" width="290" height="165" as="geometry"/></mxCell><mxCell id="core-pkg" value='&lt;b&gt;teehr-core&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Data model, metric kernels, spec schema; engine-neutral, runs standalone (LocalEvaluation)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="45" y="275" width="290" height="70" as="geometry"/></mxCell><mxCell id="shared-svc" value='&lt;b&gt;Shared deployment components&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Optional and reused by some deployments, e.g. com