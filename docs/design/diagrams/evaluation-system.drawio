y"/></mxCell><mxCell id="grp-cluster-label" value="Deployment cluster (e.g. teehr-fved)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="308" height="30" as="geometry"/></mxCell><mxCell id="bnd" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=4;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="800" height="500" as="geometry"/></mxCell><mxCell id="bnd-label" value="teehr-evaluation-system" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=default;fontSize=14;fontStyle=1;fontColor=#3d5f91;" vertex="1" parent="1"><mxGeometry x="70" y="136" width="230" height="28" as="geometry"/></mxCell><mxCell id="contract" value='&lt;b&gt;Public contracts: API / SDK, evaluation spec, extension points&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Write gateway: every write is schema-checked and attributed; results and timeseries come out here&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#a9c4eb;strokeColor=#3d5f91;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="75" y="180" width="750" height="70" as="geometry"/></mxCell><mxCell id="internal-note" value="Internals below are private" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="75" y="258" width="750" height="20" as="geometry"/></mxCell><mxCell id="control" value='&lt;b&gt;Control plane&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Projects, members, datasets, runs (Postgres)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="75" y="290" width="200" height="125" as="geometry"/></mxCell><mxCell id="grp-eval-pool" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=1;dashPattern=4 4;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="525" height="115" as="geometry"/></mxCell><mxCell id="grp-eval-pool-label" value="Evaluation work pool (shared Prefect server)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=12;fontStyle=3;fontColor=#555555;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="372" height="20" as="geometry"/></mxCell><mxCell id="upload" value='&lt;b&gt;Upload validation and registration&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Staged S3 upload → validated per-dataset Iceberg table&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="315" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="analytics" value="&lt;b&gt;On-demand analytics&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Evaluation spec → metric engine, under the caller's identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="570" y="320" width="240" height="80" as="geometry"/></mxCell><mxCell id="compute" value='&lt;b&gt;Compute&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Vectorized Python (default), Spark (large jobs), Trino (interactive reads)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="75" y="440" width="750" height="55" as="geometry"/></mxCell><mxCell id="wh" value='&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Polaris: one namespace per project · S3 / Iceberg: one prefix per project, one table per dataset; core project holds the public data&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="75" y="520" width="750" height="105" as="geometry"/></mxCell><mxCell id="grp-dep" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;dashPattern=8 8;strokeColor=#363636;" vertex="1" parent="1"><mxGeometry x="930" y="150" width="440" height="500" as="geometry"/></mxCell><mxCell id="grp-dep-label" value="Deployment-specific services (clients)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=14;fontStyle=1;fontColor=#363636;" vertex="1" parent="1"><mxGeometry x="950" y="136" width="324" height="30" as="geometry"/></mxCell><mxCell id="grp-dep-pool" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=1;dashPattern=4 4;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="945" y="190" width="410" height="230" as="geometry"/></mxCell><mxCell id="grp-dep-pool-label" value="Deployment work pool(s) (shared Prefect server)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=12;fontStyle=3;fontColor=#555555;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="955" y="180" width="396" height="20" as="geometry"/></mxCell><mxCell id="ingests" value='&lt;b&gt;Bespoke ingests&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;e.g. NWM, USGS, gridded / Icechunk, CDEC&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="215" width="185" height="85" as="geometry"/></mxCell><mxCell id="shared-flows" value='&lt;b&gt;Shared flows&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Ingests or jobs reused by several deployments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;dashed=1;" vertex="1" parent="1"><mxGeometry x="1155" y="215" width="185" height="85" as="geometry"/></mxCell><mxCell id="models" value='&lt;b&gt;Model runners&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;e.g. RiverWare; output submitted as a dataset&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="960" y="315" width="380" height="90" as="geometry"/></mxCell><mxCell id="dash" value='&lt;b&gt;Custom dashboards&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Read results and timeseries through the API&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="945" y="445" width="410" height="70" as="geometry"/></mxCell><mxCell id="tools" value='&lt;b&gt;Other tools&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Gridded tile services, bespoke notebooks, ...&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="945" y="540" width="410" height="80" as="geometry"/></mxCell><mxCell id="grp-platform" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=1;dashPattern=4 4;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="50" y="690" width="1310" height="150" as="geometry"/></mxCell><mxCell id="grp-platform-label" value="Shared platform services (substrate)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=default;fontSize=12;fontStyle=3;fontColor=#555555;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="308" height="20" as="geometry"/></mxCell><mxCell id="prefect" value='&lt;b&gt;Prefect server&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;One server; separate work pools and identities for evaluation and deployment flows&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;htm