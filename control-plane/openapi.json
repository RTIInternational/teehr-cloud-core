    "/v1/projects/{name}/members/{subject}": {
      "delete": {
        "description": "Remove a member, and their data access. Admins may remove anyone; any member\nmay leave.",
        "operationId": "remove_member",
        "parameters": [
          {
            "description": "Project name",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Project name",
              "pattern": "^[a-z][a-z0-9_]{0,59}$",
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Keycloak user id",
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "description": "Keycloak user id",
              "maxLength": 255,
              "title": "Subject",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Missing or invalid access token"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
