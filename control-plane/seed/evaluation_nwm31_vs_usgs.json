{
  "version": 1,
  "name": "nwm31-vs-usgs",
  "inputs": {
    "primary": {
      "dataset": "public.usgs_streamflow"
    },
    "secondary": [
      {
        "dataset": "public.nwm31_short_range"
      },
      {
        "dataset": "public.nwm31_medium_range_mem1"
      }
    ]
  },
  "pair": {
    "relation": "public.usgs_nwm31"
  },
  "aggregate": [
    {
      "group_by": [
        "primary_series_key",
        "secondary_dataset"
      ],
      "metrics": [
        "count",
        "kling_gupta_efficiency",
        "nash_sutcliffe_efficiency",
        "root_mean_square_error",
        "relative_bias",
        "pearson_correlation"
      ]
    }
  ],
  "output": {
    "unit": "[cft_i]/s"
  }
}
