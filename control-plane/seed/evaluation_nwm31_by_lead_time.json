{
  "version": 1,
  "name": "nwm31-by-lead-time",
  "inputs": {
    "primary": {
      "dataset": "public.usgs_inst_streamflow"
    },
    "secondary": [
      {
        "dataset": "public.nwm31_short_range"
      },
      {
        "dataset": "public.nwm31_medium_range_mem1"
      }
    ]
  },
  "pair": {
    "relation": "public.usgs_nwm31"
  },
  "fields": [
    {
      "name": "lead_time_bin",
      "fn": "lead_time_bins",
      "width": "PT6H"
    }
  ],
  "aggregate": [
    {
      "group_by": [
        "secondary_dataset",
        "lead_time_bin"
      ],
      "metrics": [
        "count",
        "kling_gupta_efficiency",
        "root_mean_square_error",
        "relative_bias"
      ]
    }
  ],
  "output": {
    "unit": "[cft_i]/s"
  }
}
